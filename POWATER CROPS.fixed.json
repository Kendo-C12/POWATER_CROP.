            "",
            "",
            "if (!runtimeScene._powaterWiringInstance) {",
            "  runtimeScene._powaterWiringInstance = new POWATER.WiringManager();",
            "}",
            "runtimeScene._powaterWiringInstance.update(runtimeScene);",
